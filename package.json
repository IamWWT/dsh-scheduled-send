{
  "name": "dsh-scheduled-send",
  "version": "0.9.5",
  "description": "DSH 定时任务：复用官方 Schedule 服务，提供 WorkBuddy 式提示词定时表单、任务会话、截止时间与执行状态；通知联动 dsh-notify-alert。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "scheduled",
    "timer",
    "queue"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "scripts/",
    "tsconfig.json",
    "tsconfig.client.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs --no-typecheck",
    "build:full": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && node test/smoke-test.mjs && node test/routes-test.mjs && node test/session-opener-test.mjs && node test/session-meta-test.mjs && node test/ui-hooks-regression-test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node test/smoke-test.mjs && node test/routes-test.mjs && node test/session-opener-test.mjs && node test/session-meta-test.mjs && node test/ui-hooks-regression-test.mjs",
    "pack": "npm pack",
    "verify:installed": "node scripts/verify-installed.mjs",
    "install:dev": "bash scripts/install-to-dsh.sh",
    "e2e": "node scripts/e2e-3082.mjs",
    "test:smoke": "node test/smoke-test.mjs",
    "test:routes": "node test/routes-test.mjs",
    "test:opener": "node test/session-opener-test.mjs",
    "test:meta": "node test/session-meta-test.mjs",
    "test:hooks": "node test/ui-hooks-regression-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
